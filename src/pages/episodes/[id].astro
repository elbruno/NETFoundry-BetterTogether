---
import Layout from '../../layouts/Layout.astro';
import { episodes } from '../../lib/episodes.mjs';
import type { Episode } from '../../lib/episodes.mjs';
interface Props {
  episode: Episode;
  index: number;
}
export function getStaticPaths() {
  return episodes.map((episode, index) => ({ params: { id: episode.id }, props: { episode, index } }));
}
const { episode, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const previous = episodes[index - 1];
const next = episodes[index + 1];
---
<Layout title={`${episode.title} | Better Together`} description={episode.summary}>
  <div class="container episode-page">
    <a class="back-link" href={`${base}/#episodes`}>&#8592; All episodes</a>
    <header class="episode-heading">
      <p class="eyebrow">EPISODE {String(episode.number).padStart(2, '0')}</p>
      <h1>{episode.title.replace(/^Episode \d+: /, '')}</h1>
      <time datetime={episode.start} data-local-date>{new Date(episode.start).toLocaleString('en-US', { timeZone: 'UTC', dateStyle: 'full', timeStyle: 'short' })} UTC</time>
      {episode.hosts.length > 0 && <p class="host-byline">With {episode.hosts.map((host, index) => <>{index > 0 && ' and '}<a href={host.url}>{host.title}</a></>)}</p>}
      <div class="actions">
        {episode.recordings.map((recording, index) => <a class={`button ${index === 0 ? 'primary' : ''}`} href={recording.url}>{recording.title} &#8599;</a>)}
        <a class={`button ${episode.recording ? '' : 'primary'}`} href={episode.eventUrl}>{episode.recording ? 'Reactor event page' : 'Event & registration'} &#8599;</a>
        {!episode.recording && <a class="button" href={`${base}/calendar/${episode.id}.ics`}>Add to calendar</a>}
        <a class="button" href={episode.sourceUrl}>View on GitHub &#8599;</a>
      </div>
      {episode.number === 1 && (
        <div class="episode-topic-list" aria-label="Episode topics">
          {['Microsoft-Decision-1', 'Decision models', 'Choices in C#', 'AI-powered games'].map((topic) => <span>{topic}</span>)}
        </div>
      )}
      {!episode.recording && <p class="notice">Recording not yet available. A confirmed watch link will appear here after the session.</p>}
    </header>
    <div class="episode-layout">
      <aside class="episode-sidebar">
        <h2>In this episode</h2>
        <nav aria-label="Episode demos">
          {episode.demos.length ? episode.demos.map((demo) => <a href={demo.url}>{demo.title} &#8599;</a>) : <p>Demos will be added when available.</p>}
        </nav>
        <p>Code stays in the repository. Each demo README includes its own run instructions.</p>
        {episode.guestResources.length > 0 && <>
          <h2>Guest demos &amp; resources</h2>
          <nav aria-label="Guest resources">
            {episode.guestResources.map((resource) => <a href={resource.url}>{resource.title} &#8599;</a>)}
          </nav>
          <p>Guest labs are maintained separately. Follow their own setup, cost, and cleanup guides.</p>
        </>}
      </aside>
      <article class="prose" aria-label="Episode guide" set:html={episode.html} />
    </div>
    <nav class="episode-pagination" aria-label="More episodes">
      {previous ? <a href={`${base}/episodes/${previous.id}/`}>&#8592; Episode {previous.number}</a> : <span />}
      {next && <a href={`${base}/episodes/${next.id}/`}>Episode {next.number} &#8594;</a>}
    </nav>
  </div>
</Layout>
