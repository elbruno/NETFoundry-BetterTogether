@using DecisionLab.Web
@using System.Globalization

<section class="live-charts" aria-label="Live model comparison charts">
    <h2>Live comparison trends</h2>
    <p>Updates after each model response. X axis: pair number, 1 to @PlannedPairs.
        Solid: generative model. Dashed: decision model. Each plot shares one scale across models.</p>
    <div class="chart-grid">
        @Plot("Cumulative tokens", p => p.Tokens, "tokens")
        @Plot("Cumulative request time", p => p.ElapsedSeconds, "seconds")
        @Plot("Estimated cumulative cost", p => p.Cost, "USD")
        @Plot("Per-request latency", p => p.LatencyMs, "ms")
    </div>
    <p class="chart-note">Token curves require complete total or input/output coverage.
        Cost curves require both rates and input/output usage for every successful response.
        Unknown values are not plotted as zero. Costs cover successful responses only,
        exclude cache discounts and other charges, and are not a billing ledger.
        Request time sums each model's call durations, including failed/cancelled calls;
        parallel models' times must not be added to infer run wall time.</p>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MetricPoint> Chat { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<MetricPoint> Decision { get; set; } = [];
    [Parameter] public int PlannedPairs { get; set; }

    private RenderFragment Plot(string title, Func<MetricPoint, double?> selector, string unit) => @<article class="chart">
        <h3>@title</h3>
        @{
            var values = Chat.Concat(Decision).Select(selector).OfType<double>().ToArray();
            double maximum = values.Length == 0 ? 1 : Math.Max(values.Max(), 0.000001);
        }
        <svg viewBox="0 0 640 220" role="img" aria-label="@($"{title}: generative solid, decision dashed; {unit}")">
            <line x1="40" y1="30" x2="40" y2="180" class="chart-axis" />
            <line x1="40" y1="180" x2="600" y2="180" class="chart-axis" />
            <text x="40" y="20" class="chart-label">@maximum.ToString("G4", CultureInfo.InvariantCulture) @unit</text>
            <text x="16" y="184" class="chart-label">0</text>
            <text x="40" y="208" class="chart-label">1</text>
            <text x="580" y="208" class="chart-label">@PlannedPairs</text>
            <polyline points="@ComparisonMetrics.Polyline(Chat, selector, PlannedPairs, maximum)" class="chart-line chat-line" />
            <polyline points="@ComparisonMetrics.Polyline(Decision, selector, PlannedPairs, maximum)" class="chart-line decision-line" />
            @foreach (var point in Chat.Where(p => selector(p).HasValue))
            {
                <circle cx="@X(point)" cy="@Y(point, selector, maximum)" r="3" class="chat-dot">
                    <title>Generative, pair @point.Pair: @selector(point)?.ToString("G6", CultureInfo.InvariantCulture) @unit</title>
                </circle>
            }
            @foreach (var point in Decision.Where(p => selector(p).HasValue))
            {
                <circle cx="@X(point)" cy="@Y(point, selector, maximum)" r="3" class="decision-dot">
                    <title>Decision, pair @point.Pair: @selector(point)?.ToString("G6", CultureInfo.InvariantCulture) @unit</title>
                </circle>
            }
        </svg>
        <p class="chart-values">
            <span class="chat-key">Generative: @Latest(Chat, selector, unit)</span>
            <span class="decision-key">Decision: @Latest(Decision, selector, unit)</span>
        </p>
        @if (values.Length == 0) { <small>Waiting for usage or configured rates; no zero values assumed.</small> }
    </article>;

    private string X(MetricPoint p) => (40 + (p.Pair - 1) * 560d / Math.Max(1, PlannedPairs - 1)).ToString("F2", CultureInfo.InvariantCulture);
    private static string Y(MetricPoint p, Func<MetricPoint, double?> select, double maximum) =>
        (180 - select(p)!.Value * 150 / maximum).ToString("F2", CultureInfo.InvariantCulture);
    private static string Latest(IReadOnlyList<MetricPoint> points, Func<MetricPoint, double?> select, string unit) =>
        points.Count == 0 || select(points[^1]) is not { } value ? "not available" :
            $"{value.ToString(unit == "USD" ? "F6" : "N2", CultureInfo.InvariantCulture)} {unit}";
}
