      "x": 1840,
      "y": 655,
      "width": 317.0,
      "height": 90.0,
      "text": "If a control blocks",
      "fontSize": 36,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t52",
      "type": "text",
      "x": 1840,
      "y": 725,
      "width": 354.0,
      "height": 450.0,
      "text": "Do not advance past\nthat checkpoint.\n\nHandle the service signal;\ndo not assume HTTP 200\nmeans unfiltered content.",
      "fontSize": 30,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t53",
      "type": "text",
      "x": 80,
      "y": 1120,
      "width": 1180.015625,
      "height": 67.5,
      "text": "*Default synchronous output mode shown. Async filtering may release content before a later block.",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t54",
      "type": "text",
      "x": 80,
      "y": 1170,
      "width": 1224.0,
      "height": 67.5,
      "text": "Arbitrary MCP tools are not listed for agent tool-call/response moderation. Verify current tool support.",
      "fontSize": 27,
