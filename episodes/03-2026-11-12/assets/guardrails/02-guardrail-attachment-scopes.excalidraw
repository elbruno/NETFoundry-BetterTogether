    },
    {
      "id": "t12",
      "type": "text",
      "x": 115,
      "y": 470,
      "width": 368.0,
      "height": 80.0,
      "text": "Prompts + completions",
      "fontSize": 32,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t13",
      "type": "text",
      "x": 115,
      "y": 530,
      "width": 652.953125,
      "height": 225.0,
      "text": "Configure the policy on the deployment.\nDirect model callers use that deployment's filter,\neven when the calling application runs locally.",
      "fontSize": 30,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "b14",
      "type": "rectangle",
      "x": 1240,
      "y": 380,
