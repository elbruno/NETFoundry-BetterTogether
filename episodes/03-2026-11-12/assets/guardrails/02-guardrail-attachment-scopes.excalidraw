        "type": 3
      }
    },
    {
      "id": "t15",
      "type": "text",
      "x": 1275,
      "y": 402,
      "width": 372.0,
      "height": 107.5,
      "text": "AGENT  (Preview)",
      "fontSize": 43,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t16",
      "type": "text",
      "x": 1275,
      "y": 470,
      "width": 691.015625,
      "height": 80.0,
      "text": "Input + output + supported tool checkpoints",
      "fontSize": 32,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t17",
      "type": "text",
      "x": 1275,
      "y": 530,
      "width": 714.0,
      "height": 225.0,
      "text": "Assign a policy to a Foundry Agent Service agent.\nCustom agent policy can override model inheritance.\nHosted-agent boundary filtering is independent.*",
      "fontSize": 30,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "b18",
      "type": "rectangle",
      "x": 80,
      "y": 790,
      "width": 1080,
      "height": 340,
      "strokeColor": "#C45B00",
      "backgroundColor": "#FFF4CE",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "roundness": {
        "type": 3
      }
    },
    {
      "id": "t19",
      "type": "text",
      "x": 115,
      "y": 812,
      "width": 413.953125,
      "height": 107.5,
      "text": "TOOLBOX VERSION",
      "fontSize": 43,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t20",
      "type": "text",
      "x": 115,
      "y": 880,
      "width": 341.953125,
      "height": 80.0,
      "text": "Tool inputs + outputs",
      "fontSize": 32,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t21",
      "type": "text",
      "x": 115,
      "y": 940,
      "width": 632.984375,
      "height": 225.0,
      "text": "Attach a named policy to the toolbox version.\nFiltering runs at the toolbox layer,\nindependently of model-level content filtering.",
      "fontSize": 30,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "b22",
      "type": "rectangle",
      "x": 1240,
      "y": 790,
      "width": 1080,
      "height": 340,
      "strokeColor": "#107C10",
      "backgroundColor": "#DFF6DD",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "roundness": {
        "type": 3
      }
    },
    {
      "id": "t23",
      "type": "text",
      "x": 1275,
      "y": 812,
      "width": 790.015625,
      "height": 107.5,
      "text": "HOSTED NETWORK EGRESS  (Preview)",
      "fontSize": 43,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t24",
      "type": "text",
      "x": 1275,
      "y": 880,
      "width": 690.0,
      "height": 80.0,
      "text": "Outbound destinations, not content meaning",
      "fontSize": 32,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t25",
      "type": "text",
      "x": 1275,
      "y": 940,
      "width": 781.953125,
      "height": 225.0,
      "text": "Attach egress rules through the hosted agent's RAI policy.\nOrdered rules: first match, then default action.\nAudit logs would-deny traffic; Enforce blocks denials.",
      "fontSize": 30,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t26",
      "type": "text",
      "x": 80,
      "y": 1165,
      "width": 1262.96875,
      "height": 65.0,
      "text": "*Hosted agents: no rai_config means no agent-boundary content guardrail. Model-call filtering can still apply.",
      "fontSize": 26,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t27",
      "type": "text",
      "x": 80,
      "y": 1210,
      "width": 1304.921875,
      "height": 65.0,
      "text": "These controls do not replace tool permissions, managed identity, DLP, human approval or application validation.",
      "fontSize": 26,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    },
    {
      "id": "t28",
      "type": "text",
      "x": 80,
      "y": 1280,
      "width": 1302.984375,
      "height": 55.0,
      "text": "Sources: Microsoft Learn, Guardrails overview; Toolbox guide; Hosted agent content safety and guardrail setup. Checked 2026-11-12.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.4
    }
